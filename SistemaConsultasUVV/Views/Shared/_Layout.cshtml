<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Consultas UVV</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Consultas UVV</a>
                <div class="navbar-nav ms-auto flex-row">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a class="nav-link text-white me-3" asp-controller="Consultas" asp-action="Index">Minhas Consultas</a>
                        <a class="nav-link text-white me-3" asp-controller="Consultas" asp-action="Create">Nova Consulta</a>
                        <span class="nav-link text-white-50 me-3">Olá, @User.Identity.Name</span>
                        <a class="nav-link text-white" asp-controller="Conta" asp-action="Logout">Sair</a>
                    }
                    else
                    {
                        <a class="nav-link text-white me-3" asp-controller="Conta" asp-action="Login">Login</a>
                        <a class="nav-link text-white" asp-controller="Conta" asp-action="Registro">Cadastrar</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (TempData["Sucesso"] != null)
        {
            <div class="alert alert-success">@TempData["Sucesso"]</div>
        }
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
