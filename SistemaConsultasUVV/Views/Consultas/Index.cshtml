@model IEnumerable<Consulta>
@{
    ViewData["Title"] = "Minhas Consultas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Minhas Consultas</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nova Consulta</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Você ainda não possui consultas cadastradas.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Especialidade</th>
                <th>Data/Hora</th>
                <th>Descrição</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var consulta in Model)
            {
                <tr>
                    <td>@consulta.Especialidade</td>
                    <td>@consulta.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@consulta.Descricao</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@consulta.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@consulta.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
