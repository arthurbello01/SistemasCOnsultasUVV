@model Consulta
@{
    ViewData["Title"] = "Excluir Consulta";
}

<h2 class="text-danger">Excluir Consulta</h2>
<p>Tem certeza que deseja excluir a consulta abaixo?</p>

<dl class="row">
    <dt class="col-sm-3">Especialidade</dt>
    <dd class="col-sm-9">@Model.Especialidade</dd>

    <dt class="col-sm-3">Data/Hora</dt>
    <dd class="col-sm-9">@Model.DataHora.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-3">Descrição</dt>
    <dd class="col-sm-9">@Model.Descricao</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Confirmar exclusão</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
